# ============= EASYPANEL - EXNOVA TRADING BOT v5.2 =============
# Copia este archivo a .env y completa las variables
# O configúralas directamente en el panel de EasyPanel

# Broker
BROKER_NAME=exnova
# ⚠️  Para cuenta REAL: ACCOUNT_TYPE=REAL y REAL_ACCOUNT_CONFIRMED=true
# ⚠️  Si REAL_ACCOUNT_CONFIRMED no es 'true', siempre usará PRACTICE
ACCOUNT_TYPE=PRACTICE
REAL_ACCOUNT_CONFIRMED=false

# Credenciales Exnova (OBLIGATORIO)
EXNOVA_EMAIL=tu_email@ejemplo.com
EXNOVA_PASSWORD=tu_password

# OpenCode AI (OBLIGATORIO para IA avanzada)
OPENCODE_API_KEY=tu_api_key
OPENCODE_BASE_URL=https://tecnovariedades-provedor-ia.er7iaf.easypanel.host/v1
OPENCODE_MODEL_FAST=opencode/deepseek-v4-flash-free
OPENCODE_MODEL_DEEP=opencode/qwen3.6-plus-free

# GitHub Models (fallback si OpenCode falla)
GITHUB_TOKEN=ghp_tu_token

# Trading - Configuración optimizada v5.2
DEFAULT_ASSET=EURUSD-OTC
CAPITAL_PER_TRADE=1            # % del balance por trade
EXPIRATION_TIME=180            # segundos (3 min)
MAX_MARTINGALE=0
STOP_LOSS_PERCENT=20
TAKE_PROFIT_PERCENT=10
MIN_CONFIDENCE=0.65            # Mínimo 65% para trade (antes 0.30)
MAX_CONSEC_LOSSES=4            # Parar después de 4 pérdidas
COOLDOWN_AFTER_LOSS=300        # 5min espera tras pérdida (antes 60s)
MIN_BETWEEN_TRADES=180         # 3min entre trades (antes 30s)

# Horario (Colombia UTC-5)
TRADING_START_HOUR=0
TRADING_END_HOUR=23
TRADING_END_MINUTE=59
MIN_VOLATILITY_TO_START=0.05
